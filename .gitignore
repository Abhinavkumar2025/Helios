# ==========================================
# HELIOS Git Ignore Rules
# ==========================================

# Node & Frontend Build Outputs
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Environment Variables & Local Configs
.env
**/.env
.env.local
**/.env.local
.env.*.local
**/.env.*.local
# Keep example environment templates
!.env.example
!**/.env.example

# Python Caches & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.pytest_cache/

# Local SQLite Database Files
*.db
*.sqlite
*.sqlite3
*.db-journal
helios.db
**/helios.db

# Media & Temporary AI Outputs
server/media/*
!server/media/.gitkeep
# Standalone AI Testing Tools & Local Test Folders
visualize_detection.py
test_my_images.py
model_Test_my_image/
accident_result.jpg
detected_preview.jpg
detect_demo/
detect_results/

# Raw Datasets, Runs & Heavy AI Outputs (Excluded from Git)
**/train/
**/valid/
**/test/
**/runs/
*.rf.*
**/last.pt


# OS and Editor specific
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

